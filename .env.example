# --- Base de données (Neon PostgreSQL) ---
# Créer une base sur https://neon.tech puis coller l'URL de connexion (pooled)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dibol_ai?sslmode=require"
# URL directe (non pooled), utilisée pour les migrations Prisma
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dibol_ai?sslmode=require"

# --- Auth.js ---
# Générer avec: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (mode TEST — clés commençant par sk_test_/whsec_/pk_test_) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# En local : `stripe listen --forward-to localhost:3010/api/webhooks/stripe` puis coller le secret affiché
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email transactionnel (Resend) ---
# https://resend.com/api-keys — laisser vide pour désactiver l'envoi (les commandes fonctionnent quand même)
RESEND_API_KEY=""
# Doit être un expéditeur vérifié dans Resend une fois en prod ; "onboarding@resend.dev" fonctionne sans vérification en test
EMAIL_FROM="DIBOL AI <onboarding@resend.dev>"

# --- Stockage des fichiers produits (Vercel Blob) ---
# Obligatoire en production sur Vercel (le système de fichiers y est en lecture seule).
# Laisser vide en local : le stockage bascule automatiquement sur le disque (storage/products).
# Se crée depuis l'onglet "Storage" du projet Vercel (Blob store) — le token est fourni automatiquement
# si le store est lié au projet, sinon copier-coller depuis le dashboard Vercel.
BLOB_READ_WRITE_TOKEN=""

# --- Outils IA gratuits (DIBOL AI V2) ---
# https://platform.openai.com/api-keys — laisser vide désactive la génération
# (les pages des outils restent accessibles mais renvoient une erreur claire)
OPENAI_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
