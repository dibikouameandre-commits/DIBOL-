generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
  SUPER_ADMIN
  COMPANY_ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

// --- Multi-entreprise ---

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  categories Category[]
  products   Product[]
  orders     Order[]
}

// --- Auth.js models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CLIENT)
  tokenVersion  Int       @default(0)
  isActive      Boolean   @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  accounts Account[]
  sessions Session[]
  orders   Order[]
  toolRuns ToolRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Catalogue ---

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  fileKey     String?
  fileName    String?
  isPublished Boolean  @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// --- Commandes / paiement ---

model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  status                OrderStatus @default(PENDING)
  total                 Decimal     @db.Decimal(10, 2)
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?     @unique
  stripeInvoiceId       String?     @unique
  invoicePdfUrl         String?
  paidAt                DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

// --- Outils IA gratuits (DIBOL AI V2, Phase 1) ---
// Global à la plateforme, jamais rattaché à une Company : ce sont des
// produits DIBOL AI eux-mêmes, pas du catalogue vendu par une entreprise
// cliente. Le registre des outils (nom, description, quota) vit en code
// (src/lib/tools/registry.ts), pas en base — ajouter un outil n'a donc pas
// besoin de migration ; toolSlug est juste une clé de référence.

model ToolRun {
  id       String @id @default(cuid())
  toolSlug String

  // Un visiteur peut utiliser un outil sans compte — userId est nullable.
  // anonId/ipHash permettent quand même la limite anti-abus dans ce cas.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  anonId String
  // Jamais l'IP en clair — seulement un hash, suffisant pour compter sans
  // stocker une donnée personnelle directement identifiante.
  ipHash String

  createdAt DateTime @default(now())

  result ToolResult?

  @@index([toolSlug, anonId, createdAt])
  @@index([toolSlug, ipHash, createdAt])
}

model ToolResult {
  id        String    @id @default(cuid())
  runId     String    @unique
  run       ToolRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Identifiant de partage non séquentiel (pas l'id de la ligne) — voir
  // src/lib/tokens.ts pour la génération, même pattern que les tokens de
  // vérification email/réinitialisation de mot de passe.
  shareSlug String    @unique
  content   Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}
